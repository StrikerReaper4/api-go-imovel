# Variaveis lidas pela API (todas opcionais, com fallback no codigo).

# Conexao com o banco. Local (cluster de desenvolvimento):
DATABASE_URL=postgres://imoveisgo:admin123@127.0.0.1:5440/bretasimoveisdb?sslmode=disable

# Porta HTTP da API.
PORT=8080

# Segredo de assinatura dos JWT. OBRIGATORIO em producao.
JWT_SECRET=dev-only-nao-usar-em-producao

# Usado para montar o link de redefinicao de senha no e-mail.
FRONTEND_URL=http://localhost:5173

# Envio de e-mail (recuperacao de senha). Sem isso, /senha/esqueci falha.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
